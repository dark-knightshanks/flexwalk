<mujoco>

<compiler angle="degree"/>

<option gravity="0 0 0"/>
<visual>

    <headlight
        ambient="0.4 0.4 0.4"
        diffuse="0.8 0.8 0.8"
        specular="0.2 0.2 0.2"/>

    <rgba haze="0.9 0.95 1 1"/>

</visual>
<asset>

    <!-- Sky -->
    <texture
        name="sky"
        type="skybox"
        builtin="gradient"
        rgb1="0.15 0.25 0.55"
        rgb2="0.95 0.97 1"
        width="512"
        height="512"/>

    <!-- Floor texture -->
    <texture
        name="ground_tex"
        type="2d"
        builtin="checker"
        rgb1=".85 .85 .85"
        rgb2=".75 .75 .75"
        width="512"
        height="512"/>

    <material
        name="ground_mat"
        texture="ground_tex"
        texrepeat="8 8"
        reflectance="0.15"/>

</asset>

<default>

    <joint
        damping="5"
        armature="0.01"/>

</default>

<worldbody>

    <light
        name="sun"
        pos="0 0 6"
        dir="0 0 -1"
        diffuse="1 1 1"
        specular="0.3 0.3 0.3"/>

    <geom
        name="floor"
        type="plane"
        size="10 10 0.1"
        material="ground_mat"/>
  <body name="pelvis" pos="0 0 0.6">
    <geom name="pelvis_geom" type="box" size="0.05 0.1 0.05"/>

    <!-- LEFT LEG -->
    <body name="hip_roll_L" pos="0 0.07 0">
      <joint name="hip_roll_L" type="hinge" axis="1 0 0" range="-30 30"/>
      <geom type="sphere" size="0.02" rgba="1 0 0 1"/>

      <body name="hip_pitch_L" pos="0 0 0">
        <joint name="hip_pitch_L" type="hinge" axis="0 1 0" range="-60 90"/>
        <geom type="sphere" size="0.02" />

        <body name="thigh_L" pos="0 0 -0.15">
          <geom type="cylinder" size="0.04 0.15" pos="0 0 0" rgba="1 0 0 1"/>
          <inertial pos="0 0 0" mass="0.5" diaginertia="0.005 0.005 0.001"/>

          <body name="knee_pitch_L" pos="0 0 -0.15">
            <joint name="knee_pitch_L" type="hinge" axis="0 1 0" range="-120 0"/>
            <geom type="sphere" size="0.02"/>

            <body name="shank_L" pos="0 0 -0.10">
              <geom type="cylinder" size="0.018 0.10" pos="0 0 0"/>
              <inertial pos="0 0 0" mass="0.3" diaginertia="0.003 0.003 0.001"/>

              <body name="ankle_pitch_L" pos="0 0 -0.10">
                <joint name="ankle_pitch_L" type="hinge" axis="0 1 0" range="-45 45"/>
                <geom type="sphere" size="0.015"/>

                <body name="ankle_roll_L" pos="0 0 0">
                  <joint name="ankle_roll_L" type="hinge" axis="1 0 0" range="-25 25"/>
                  <geom type="sphere" size="0.015"/>

                  <body name="foot_L" pos="0 0 -0.03">
                    <geom type="box" size="0.05 0.03 0.01"/>
                    <inertial pos="0 0 0" mass="0.1" diaginertia="0.0001 0.0001 0.0001"/>
                    <site name="foot_ee_L" pos="0 0 -0.01" size="0.005"/>
                  </body>

                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
   <body name="hip_roll_R" pos="0 -0.07 0">
      <joint name="hip_roll_R" type="hinge" axis="1 0 0" range="-30 30"/>
      <geom type="sphere" size="0.02" rgba ="1 0 0 1"/>

      <body name="hip_pitch_R" pos="0 0 0">
        <joint name="hip_pitch_R" type="hinge" axis="0 1 0" range="-60 90"/>
        <geom type="sphere" size="0.02"/>

        <body name="thigh_R" pos="0 0 -0.15">
          <geom type="cylinder" size="0.04 0.15" pos="0 0 0" rgba="1 0 0 1"/>
          <inertial pos="0 0 0" mass="0.5" diaginertia="0.005 0.005 0.001"/>

          <body name="knee_pitch_R" pos="0 0 -0.15">
            <joint name="knee_pitch_R" type="hinge" axis="0 1 0" range="-120 0"/>
            <geom type="sphere" size="0.02"/>

            <body name="shank_R" pos="0 0 -0.10">
              <geom type="cylinder" size="0.018 0.10" pos="0 0 0"/>
              <inertial pos="0 0 0" mass="0.3" diaginertia="0.003 0.003 0.001"/>

              <body name="ankle_pitch_R" pos="0 0 -0.10">
                <joint name="ankle_pitch_R" type="hinge" axis="0 1 0" range="-45 45"/>
                <geom type="sphere" size="0.015"/>

                <body name="ankle_roll_R" pos="0 0 0">
                  <joint name="ankle_roll_R" type="hinge" axis="1 0 0" range="-25 25"/>
                  <geom type="sphere" size="0.015"/>

                  <body name="foot_R" pos="0 0 -0.03">
                    <geom type="box" size="0.05 0.03 0.01"/>
                    <inertial pos="0 0 0" mass="0.1" diaginertia="0.0001 0.0001 0.0001"/>
                    <site name="foot_ee_R" pos="0 0 -0.01" size="0.005"/>
                  </body>

                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>

  </body>
</worldbody>
</mujoco>


